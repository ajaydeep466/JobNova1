# Copy to /opt/jobnova/.env  (setup.sh does this and fills the two random values)
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me
# Used by the Cloudflare Worker + old /admin/...?key= routes. Letters and numbers only.
ADMIN_KEY=change-me
SITE_URL=https://jobnova.net.in

# Database: SQLite file (free, no extra RAM). Use your Aiven/Postgres URL instead if you prefer.
DATABASE_URL=sqlite:////opt/jobnova/data/jobnova.db

# Auto fetch (runs inside the app, VM never sleeps)
ENABLE_SCHEDULER=1
FETCH_EVERY_HOURS=3
PRIVATE_JOBS=0

# Set to 0 only if you test over plain http on your own computer
COOKIE_SECURE=1

# Optional: copy these values from your Render environment
TELEGRAM_URL=https://t.me/jobnova_jobs
CONTACT_EMAIL=jobnova.net@gmail.com
ADSENSE_CLIENT=
ADSENSE_SLOT=
GMAIL_USER=
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
MAIL_FROM=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Workers AI (free daily allowance). When these two are set it is used instead of OpenRouter.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Hard daily limits (per UTC day). Hand-written admin posts are never limited.
DAILY_AI_LIMIT=30
DAILY_POST_LIMIT=20

# Headless Chrome for JavaScript pages (install with install_browser.sh)
JS_RENDER=1
JS_RENDER_DAILY_LIMIT=40
JS_MIN_FREE_MB=250
# Old government sites with broken HTTPS are retried tolerantly. Empty value switches it off.
SSL_FALLBACK_HOSTS=gov.in,nic.in,cdac.in,ibps.in
